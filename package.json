{
  "name": "kabiras-motors",
  "version": "1.0.0",
  "description": "A responsive website for KABIRA’S Motor Vehicle Engineering & Mechanics",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ./output.css",
    "build:prod": "tailwindcss -i ./input.css -o ./output.css --minify",
    "watch": "tailwindcss -i ./input.css -o ./output.css --watch",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
